# ld-328 CyFreshFood 环境变量示例（复制为 .env 使用）
# Docker Compose 项目短名（中文目录下也能稳定命名容器）
COMPOSE_PROJECT_NAME=cyfreshfood

# PostgreSQL
DB_NAME=cyfreshfood_db
DB_USER=cyfreshfood_user
DB_PASSWORD=cyfreshfood_pwd

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# 后端 JWT 签名密钥（生产环境请替换为高强度随机值）
JWT_SECRET=change_me_to_a_long_random_string

# 对外端口
FRONTEND_PORT=18628
BACKEND_PORT=19628
DB_PORT=5432

# 构建代理（受限网络环境使用；正常环境可留空）
HTTP_PROXY=
HTTPS_PROXY=
